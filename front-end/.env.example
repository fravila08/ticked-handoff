# Your Supabase project URL (Project Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe for the browser, but only with row level security on.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Stripe publishable key (test mode: pk_test_...). Safe for the browser.
# Never put a secret key (sk_...) in front-end/; it lives in Supabase secrets.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
