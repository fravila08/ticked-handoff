# Your Supabase project URL (Integrations > Data API > Project URL, WITHOUT /rest/v1/ on the end).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (Project Settings > API Keys). Safe in the browser: RLS decides what each user can see.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
